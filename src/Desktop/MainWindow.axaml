<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Pigeon.Manager.Desktop" x:Class="Pigeon.Manager.Desktop.MainWindow" Title="UTSL服务器管理器" Width="1510" Height="1000" MinWidth="1220" MinHeight="800" WindowStartupLocation="CenterScreen" WindowDecorations="None" CanResize="True" Icon="avares://Pigeon.UTSLManager/Assets/Branding/UTSl-Manager.ico">
 <Border BorderBrush="#42434B" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
  <Grid RowDefinitions="42,53,*,30">
   <Border x:Name="TitleBar" Background="#25262C" PointerPressed="DragWindow">
    <Grid ColumnDefinitions="190,*,190" Margin="10,0,0,0">
     <StackPanel x:Name="TrafficControls" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><Button Classes="traffic" Background="#FF6058" Click="CloseClick" ToolTip.Tip="关闭窗口，保留后台服务器"/><Button Classes="traffic" Background="#FEBC2E" Click="MinClick" ToolTip.Tip="最小化"/><Button Classes="traffic" Background="#28C840" Click="MaxClick" ToolTip.Tip="最大化 / 还原"/></StackPanel>
     <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Image Source="avares://Pigeon.UTSLManager/Assets/Branding/UTSl-Manager.png" Width="20" Height="20"/><TextBlock Text="UTSL 服务器管理器" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <StackPanel x:Name="WindowControls" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Stretch" Orientation="Horizontal" Spacing="0">
      <Button x:Name="FullscreenButton" Classes="window-control" Click="FullscreenClick" ToolTip.Tip="全屏 / 退出全屏"><LucideIcon x:Name="FullscreenGlyph" Kind="Maximize" Size="14"/></Button>
      <Button x:Name="MinimizeWindowButton" Classes="window-control" Click="MinClick" ToolTip.Tip="最小化"><LucideIcon Kind="Minus" Size="14"/></Button>
      <Button x:Name="MaximizeWindowButton" Classes="window-control" Click="MaxClick" ToolTip.Tip="最大化 / 还原"><LucideIcon x:Name="MaximizeGlyph" Kind="Square" Size="12"/></Button>
      <Button x:Name="CloseWindowButton" Classes="window-control window-close" Click="CloseClick" ToolTip.Tip="关闭窗口，保留后台服务器"><LucideIcon Kind="X" Size="16"/></Button>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Row="1" Background="#202126" BorderBrush="#35363E" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto" Margin="13,0">
     <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
      <Button x:Name="ServersNav" Classes="nav active" Click="ServersClick"><StackPanel Orientation="Horizontal" Spacing="9"><LucideIcon Kind="Server" Size="17"/><TextBlock Text="服务器"/></StackPanel></Button>
      <Button x:Name="PluginsNav" Classes="nav" Click="PluginsClick"><StackPanel Orientation="Horizontal" Spacing="9"><LucideIcon Kind="Blocks" Size="17"/><TextBlock Text="总插件库"/></StackPanel></Button>
      <Button x:Name="MapsNav" Classes="nav" Click="MapsClick"><StackPanel Orientation="Horizontal" Spacing="9"><LucideIcon Kind="Map" Size="17"/><TextBlock Text="地图工坊"/></StackPanel></Button>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,10,0"><Ellipse x:Name="HostDot" Width="6" Height="6" Fill="#D6AA69"/><TextBlock x:Name="HostStatus" Text="后台连接中" FontSize="11" Foreground="#A3A7B5"/></StackPanel><Button Classes="icon" Click="OpenRootClick" ToolTip.Tip="打开工作区根目录"><LucideIcon Kind="FolderOpen" Size="17"/></Button><Button Classes="icon" Click="AboutClick" ToolTip.Tip="关于"><LucideIcon Kind="Info" Size="17"/></Button></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid x:Name="ServersPage" ColumnDefinitions="236,*">
     <Border Background="#202126" BorderBrush="#34353D" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
       <Grid ColumnDefinitions="*,Auto" Margin="18,19,13,12"><TextBlock Text="本机服务器" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ServerCount" Grid.Column="1" Classes="muted" Text="0"/></Grid>
       <TextBox x:Name="ServerSearch" Grid.Row="1" Margin="12,0,12,11" PlaceholderText="搜索服务器" TextChanged="ServerSearchChanged"/>
       <ListBox x:Name="ServerList" Grid.Row="2" Background="Transparent" SelectionChanged="ServerSelectionChanged"/>
       <StackPanel Grid.Row="3" Margin="12,12,12,16" Spacing="7"><Button Click="ImportClick" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Plus" Size="16"/><TextBlock Text="复制导入服务端包"/></StackPanel></Button><Button Click="RegisterExistingClick" Content="登记现有目录" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
      <Grid x:Name="ServerHeader" ColumnDefinitions="*,Auto" ColumnSpacing="18" Margin="24,20,22,16">
       <StackPanel Spacing="5" VerticalAlignment="Center"><TextBlock x:Name="SelectedTitle" Text="服务器工作区" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectedSubtitle" Text="尚未导入服务器" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
       <StackPanel x:Name="ServerToolbar" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border x:Name="SelectedActionsGroup" Classes="toolbar-group">
         <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="StartButton" Classes="toolbar primary" MinWidth="76" Click="StartClick" ToolTip.Tip="启动当前服务器，等待全部世界就绪"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Play" Size="15"/><TextBlock Text="启动"/></StackPanel></Button>
          <Button x:Name="StopButton" Classes="toolbar" MinWidth="76" Click="StopClick" ToolTip.Tip="REST 保存并验证 World saved → /off 一次 → 20 秒后复核身份，仅终止单 PID"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Square" Size="14"/><TextBlock Text="停止"/></StackPanel></Button>
          <Button x:Name="RestartButton" Classes="toolbar icon" Click="RestartClick" ToolTip.Tip="先验证保存再停止；20 秒后复核身份，仅终止单 PID；停止成功才重启"><LucideIcon Kind="RotateCw" Size="16"/></Button>
         </StackPanel>
        </Border>
        <Border x:Name="BulkActionsGroup" Classes="toolbar-group">
         <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="StartAllButton" Classes="toolbar" MinWidth="104" Click="StartAllClick" ToolTip.Tip="按编号顺序启动；前一服全部世界就绪后才启动下一服，失败暂停队列"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Play" Size="15"/><TextBlock Text="全部启动"/></StackPanel></Button>
          <Button x:Name="StopAllButton" Classes="toolbar danger" MinWidth="104" Click="StopAllClick" ToolTip.Tip="确认后取消启动队列，由后台逐服保存并停止；进度显示在状态栏"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Square" Size="14"/><TextBlock Text="全部停止"/></StackPanel></Button>
         </StackPanel>
        </Border>
        <Border x:Name="SettingsActionsGroup" Classes="toolbar-group">
         <StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="ProfileButton" Classes="toolbar icon" Click="ProfileClick" ToolTip.Tip="启动设置"><LucideIcon Kind="Settings2" Size="16"/></Button><Button x:Name="ServerFolderButton" Classes="toolbar icon" Click="ServerFolderClick" ToolTip.Tip="打开此服务端目录"><LucideIcon Kind="FolderOpen" Size="16"/></Button></StackPanel>
        </Border>
       </StackPanel>
      </Grid>
      <Border Grid.Row="1" Margin="24,0,22,14" BorderBrush="#3A3B44" BorderThickness="0,0,0,1" Padding="0,0,0,12">
       <Grid x:Name="ServerDetails" ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel x:Name="ServerMetrics" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center"><TextBlock x:Name="PidLabel" Text="PID —" Classes="muted"/><TextBlock x:Name="MemoryLabel" Text="内存 —" Classes="muted"/><TextBlock x:Name="UptimeLabel" Text="运行 —" Classes="muted"/></StackPanel><StackPanel x:Name="WorldControls" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button x:Name="WorldTab1" Classes="world-tab" Content="1" Tag="0" Click="WorldTabClick" ToolTip.Tip="世界 1"/><Button x:Name="WorldTab2" Classes="world-tab" Content="2" Tag="1" Click="WorldTabClick" ToolTip.Tip="世界 2"/><Button x:Name="WorldTab3" Classes="world-tab" Content="3" Tag="2" Click="WorldTabClick" ToolTip.Tip="世界 3"/><Button x:Name="HostConsoleButton" Classes="world-tab" Width="54" Content="宿主" Tag="-1" Click="WorldTabClick"/><CheckBox x:Name="TripleToggle" Content="显示三个" IsCheckedChanged="WorldLayoutChanged" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel></Grid>
      </Border>
      <Grid Grid.Row="2" RowDefinitions="*,Auto" Margin="24,0,22,18">
       <Grid x:Name="Consoles" ColumnSpacing="10"/>
       <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,10,0,0"><TextBlock x:Name="StateHint" Text="未自动启动任何服务器" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button x:Name="ForceButton" Grid.Column="1" Content="强制停止此 PID…" IsVisible="False" Click="ForceClick" Foreground="#EDAE98" MinHeight="24" Padding="8,3" FontSize="11"/></Grid>
      </Grid>
     </Grid>
    </Grid>
    <Grid x:Name="PluginsPage" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" Margin="30,24">
     <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="总插件库" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="PluginCount" Text="0 个插件" Classes="muted"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Click="OpenLibraryClick" Classes="icon" ToolTip.Tip="打开插件库"><LucideIcon Kind="FolderOpen" Size="17"/></Button><Button Click="AddPluginsClick" Classes="primary"><StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Plus" Size="16"/><TextBlock Text="导入 DLL"/></StackPanel></Button></StackPanel></Grid>
     <Grid Grid.Row="1" ColumnDefinitions="*,180,125,150" Margin="12,27,15,10"><TextBlock Text="插件 / 文件名" Classes="muted"/><TextBlock Grid.Column="1" Text="程序集版本" Classes="muted"/><TextBlock Grid.Column="2" Text="大小" Classes="muted"/><TextBlock Grid.Column="3" Text="SHA256" Classes="muted"/></Grid>
     <ListBox x:Name="PluginList" Grid.Row="2" SelectionMode="Multiple" Background="#1D1E23"/>
     <Border Grid.Row="3" BorderBrush="#3A3B44" BorderThickness="0,1,0,0" Padding="0,17,0,0"><Grid ColumnDefinitions="Auto,280,*,Auto" ColumnSpacing="14"><TextBlock Text="目标服务器" VerticalAlignment="Center" Classes="muted"/><ComboBox x:Name="PluginTarget" Grid.Column="1"/><TextBlock x:Name="PluginStatus" Grid.Column="2" Text="尚未同步" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap"/><Button Grid.Column="3" Click="ApplyPluginsClick"><StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="ArrowDownToLine" Size="16"/><TextBlock Text="备份并同步所选"/></StackPanel></Button></Grid></Border>
    </Grid>
    <ContentControl x:Name="MapsPage" IsVisible="False"/>
   </Grid>
   <Border Grid.Row="3" Background="#222329" BorderBrush="#36373F" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto" Margin="15,0"><TextBlock x:Name="StatusText" Text="本地工作区" Classes="muted" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="流光工作室  ·  Pigeon-X  ·  0.1" Foreground="#8B90A2" FontSize="10" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Border>
</Window>
