<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Pigeon.Manager.Desktop" x:Class="Pigeon.Manager.Desktop.MainWindow" Title="UTSL服务器管理器" Width="1510" Height="1000" MinWidth="1220" MinHeight="800" WindowStartupLocation="CenterScreen" WindowDecorations="None" CanResize="True" Icon="avares://Pigeon.UTSLManager/Assets/Branding/UTSl-Manager.ico">
 <Border BorderBrush="#42434B" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
  <Grid RowDefinitions="42,53,*,30">
   <Border x:Name="TitleBar" Background="#25262C" PointerPressed="DragWindow">
    <Grid ColumnDefinitions="190,*,190" Margin="10,0,0,0">
     <StackPanel x:Name="TrafficControls" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><Button Classes="traffic" Background="#FF6058" Click="CloseClick" ToolTip.Tip="关闭窗口，保留后台服务器"/><Button Classes="traffic" Background="#FEBC2E" Click="MinClick" ToolTip.Tip="最小化"/><Button Classes="traffic" Background="#28C840" Click="MaxClick" ToolTip.Tip="最大化 / 还原"/></StackPanel>
     <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Image Source="avares://Pigeon.UTSLManager/Assets/Branding/UTSl-Manager.png" Width="20" Height="20"/><TextBlock Text="UTSL 服务器管理器" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <StackPanel x:Name="WindowControls" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Stretch" Orientation="Horizontal" Spacing="0">
      <Button x:Name="FullscreenButton" Classes="window-control" Click="FullscreenClick" ToolTip.Tip="全屏 / 退出全屏"><LucideIcon x:Name="FullscreenGlyph" Kind="Maximize" Size="14"/></Button>
      <Button x:Name="MinimizeWindowButton" Classes="window-control" Click="MinClick" ToolTip.Tip="最小化"><LucideIcon Kind="Minus" Size="14"/></Button>
      <Button x:Name="MaximizeWindowButton" Classes="window-control" Click="MaxClick" ToolTip.Tip="最大化 / 还原"><LucideIcon x:Name="MaximizeGlyph" Kind="Square" Size="12"/></Button>
      <Button x:Name="CloseWindowButton" Classes="window-control window-close" Click="CloseClick" ToolTip.Tip="关闭窗口，保留后台服务器"><LucideIcon Kind="X" Size="16"/></Button>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Row="1" Background="#202126" BorderBrush="#35363E" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto" Margin="13,0">
     <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
      <Button x:Name="ServersNav" Classes="nav active" Click="ServersClick"><StackPanel Orientation="Horizontal" Spacing="9"><LucideIcon Kind="Server" Size="17"/><TextBlock Text="服务器"/></StackPanel></Button>
      <Button x:Name="PluginsNav" Classes="nav" Click="PluginsClick"><StackPanel Orientation="Horizontal" Spacing="9"><LucideIcon Kind="Blocks" Size="17"/><TextBlock Text="总插件库"/></StackPanel></Button>
      <Button x:Name="MapsNav" Classes="nav" Click="MapsClick"><StackPanel Orientation="Horizontal" Spacing="9"><LucideIcon Kind="Map" Size="17"/><TextBlock Text="地图工坊"/></StackPanel></Button>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,10,0"><Ellipse x:Name="HostDot" Width="6" Height="6" Fill="#D6AA69"/><TextBlock x:Name="HostStatus" Text="后台连接中" FontSize="11" Foreground="#A3A7B5"/></StackPanel><Button Classes="icon" Click="OpenRootClick" ToolTip.Tip="打开工作区根目录"><LucideIcon Kind="FolderOpen" Size="17"/></Button><Button Classes="icon" Click="AboutClick" ToolTip.Tip="关于"><LucideIcon Kind="Info" Size="17"/></Button></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid x:Name="ServersPage" ColumnDefinitions="236,*">
     <Border Background="#202126" BorderBrush="#34353D" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
       <Grid ColumnDefinitions="*,Auto" Margin="18,19,13,12"><TextBlock Text="本机服务器" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ServerCount" Grid.Column="1" Classes="muted" Text="0"/></Grid>
       <TextBox x:Name="ServerSearch" Grid.Row="1" Margin="12,0,12,11" PlaceholderText="搜索服务器" TextChanged="ServerSearchChanged"/>
       <ListBox x:Name="ServerList" Grid.Row="2" Background="Transparent" SelectionChanged="ServerSelectionChanged"/>
       <StackPanel Grid.Row="3" Margin="12,12,12,16" Spacing="7"><Button Click="ImportClick" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="8"><LucideIcon Kind="Plus" Size="16"/><TextBlock Text="复制导入服务端包"/></StackPanel></Button><Button Click="RegisterExistingClick" Content="登记现有目录" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
      <Grid x:Name="ServerHeader" ColumnDefinitions="*,Auto" ColumnSpacing="18" Margin="24,20,22,16">
       <StackPanel Spacing="5" VerticalAlignment="Center"><TextBlock x:Name="SelectedTitle" Text="服务器工作区" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectedSubtitle" Text="尚未导入服务器" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
       <StackPanel x:Name="ServerToolbar" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border x:Name="SelectedActionsGroup" Classes="toolbar-group">
         <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="StartButton" Classes="toolbar primary" MinWidth="76" Click="StartClick" ToolTip.Tip="启动当前服务器，等待全部世界就绪"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Play" Size="15"/><TextBlock Text="启动"/></StackPanel></Button>
          <Button x:Name="StopButton" Classes="toolbar" MinWidth="76" Click="StopClick" ToolTip.Tip="REST 保存并验证 World saved → /off 一次 → 20 秒后复核身份，仅终止单 PID"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Square" Size="14"/><TextBlock Text="停止"/></StackPanel></Button>
          <Button x:Name="RestartButton" Classes="toolbar icon" Click="RestartClick" ToolTip.Tip="先验证保存再停止；20 秒后复核身份，仅终止单 PID；停止成功才重启"><LucideIcon Kind="RotateCw" Size="16"/></Button>
         </StackPanel>
        </Border>
        <Border x:Name="BulkActionsGroup" Classes="toolbar-group">
         <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="StartAllButton" Classes="toolbar" MinWidth="104" Click="StartAllClick" ToolTip.Tip="按编号顺序启动；前一服全部世界就绪后才启动下一服，失败暂停队列"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Play" Size="15"/><TextBlock Text="全部启动"/></StackPanel></Button>
          <Button x:Name="StopAllButton" Classes="toolbar danger" MinWidth="104" Click="StopAllClick" ToolTip.Tip="确认后取消启动队列，由后台逐服保存并停止；进度显示在状态栏"><StackPanel Orientation="Horizontal" Spacing="6"><LucideIcon Kind="Square" Size="14"/><TextBlock Text="全部停止"/></StackPanel></Button>
         </StackPanel>
        </Border>
        <Border x:Name="SettingsActionsGroup" Classes="toolbar-group">
         <StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="ProfileButton" Classes="toolbar icon" Click="ProfileClick" ToolTip.Tip="启动设置"><LucideIcon Kind="Settings2" Size="16"/></Button><Button x:Name="ServerFolderButton" Classes="toolbar icon" Click="ServerFolderClick" ToolTip.Tip="打开此服务端目录"><LucideIcon Kind="FolderOpen" Size="16"/></Button></StackPanel>
        </Border>
       </StackPanel>
      </Grid>
      <Border Grid.Row="1" Margin="24,0,22,14" BorderBrush="#3A3B44" BorderThickness="0,0,0,1" Padding="0,0,0,12">
       <Grid x:Name="ServerDetails" ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel x:Name="ServerMetrics" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center"><TextBlock x:Name="PidLabel" Text="PID —" Classes="muted"/><TextBlock x:Name="MemoryLabel" Text="内存 —" Classes="muted"/><TextBlock x:Name="UptimeLabel" Text="运行 —" Classes="muted"/></StackPanel><StackPanel x:Name="WorldControls" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button x:Name="WorldTab1" Classes="world-tab" Content="1" Tag="0" Click="WorldTabClick" ToolTip.Tip="世界 1"/><Button x:Name="WorldTab2" Classes="world-tab" Content="2" Tag="1" Click="WorldTabClick" ToolTip.Tip="世界 2"/><Button x:Name="WorldTab3" Classes="world-tab" Content="3" Tag="2" Click="WorldTabClick" ToolTip.Tip="世界 3"/><CheckBox x:Name="TripleToggle" Content="显示三个" IsCheckedChanged="WorldLayoutChanged" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel></Grid>
      </Border>
      <Grid Grid.Row="2" RowDefinitions="*,Auto" Margin="24,0,22,18">
       <Grid x:Name="Consoles" ColumnSpacing="10"/>
       <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,10,0,0"><TextBlock x:Name="StateHint" Text="未自动启动任何服务器" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button x:Name="ForceButton" Grid.Column="1" Content="强制停止此 PID…" IsVisible="False" Click="ForceClick" Foreground="#EDAE98" MinHeight="24" Padding="8,3" FontSize="11"/></Grid>
      </Grid>
     </Grid>
    </Grid>
    <Grid x:Name="PluginsPage" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14" Margin="26,22">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="5"><TextBlock Text="总插件库" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="主库统一当前版本，历史版本集中归档并可回退" Classes="muted" FontSize="11"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button x:Name="RefreshLibraryButton" Click="RefreshLibraryClick" Classes="icon" ToolTip.Tip="刷新总库及目标服已保存的选择"><LucideIcon Kind="RotateCw" Size="16"/></Button>
       <Button x:Name="OrganizeLibraryButton" Click="OrganizeLibraryClick" Content="整理归档"/>
       <Button x:Name="RestoreLibraryButton" Click="RestoreLibraryClick" Content="设为当前版本" ToolTip.Tip="将列表中高亮的历史版本恢复到主库；不会自动改动运行中的沙箱"/>
       <Button x:Name="ImportSharedPluginsButton" Click="ImportSharedPluginsClick" Classes="primary"><StackPanel Orientation="Horizontal" Spacing="7"><LucideIcon Kind="Plus" Size="16"/><TextBlock Text="收录插件版本"/></StackPanel></Button>
      </StackPanel>
     </Grid>
     <Border Grid.Row="1" Background="#222329" BorderBrush="#393B46" BorderThickness="1" CornerRadius="6" Padding="12,9">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock x:Name="PluginStatus" Text="打开此页后载入共享库与目标服配置" TextWrapping="Wrap" FontSize="11" MaxHeight="70" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CancelLibraryImportButton" Content="取消失败导入" Click="CancelLibraryImportClick" ToolTip.Tip="仅可取消尚未提交的导入；保留失败记录，已提交更新继续按原计划恢复"/></Grid>
     </Border>
     <Grid Grid.Row="2" ColumnDefinitions="*,370" ColumnSpacing="16">
      <Border Background="#1D1E23" BorderBrush="#353740" BorderThickness="1" CornerRadius="7">
       <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="3,1,3,10"><TextBlock Text="共享插件 · 当前版本" FontWeight="SemiBold"/><CheckBox x:Name="ShowArchivedPlugins" Grid.Column="1" Content="查看历史" IsCheckedChanged="ShowArchivedPluginsChanged"/><TextBlock x:Name="ArtifactCount" Grid.Column="2" Text="0 个插件" Classes="muted" FontSize="11"/></Grid>
        <TextBox x:Name="LibrarySearch" Grid.Row="1" PlaceholderText="搜索名称、文件名、版本或 SHA256" TextChanged="LibrarySearchChanged" Margin="0,0,0,9"/>
        <Grid Grid.Row="2">
         <ListBox x:Name="ArtifactList" Background="Transparent" SelectionMode="Single"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles></ListBox>
         <TextBlock x:Name="LibraryEmptyHint" Text="总库暂无插件，请收录 DLL 或导入目标服现有插件" TextWrapping="Wrap" Classes="muted" MaxWidth="330" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock Grid.Row="3" Text="主目录每个插件仅保留一个当前版本。旧版归入 Plugins/Archive；查看历史后可选定并恢复。运行中的精确版本不变。" TextWrapping="Wrap" Classes="muted" FontSize="10" Margin="3,9,3,0"/>
       </Grid>
      </Border>
      <Border Grid.Column="1" Background="#202127" BorderBrush="#3A3C48" BorderThickness="1" CornerRadius="7">
       <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12">
         <TextBlock Text="目标服运行环境" FontSize="14" FontWeight="SemiBold"/>
         <ComboBox x:Name="PluginTarget" SelectionChanged="PluginTargetChanged" PlaceholderText="选择目标服务器"/>
         <TextBlock x:Name="RuntimeTargetStatus" Text="请选择目标服务器" TextWrapping="Wrap" FontSize="11" Foreground="#D6B37E"/>
         <CheckBox x:Name="RuntimeEnabled" Content="启用独立 runtime 沙箱" IsCheckedChanged="RuntimeEnabledChanged"/>
         <TextBlock Text="关闭时仍可预选并保存核心与插件，运行沿用原服；开启后使用此处保存的版本。" TextWrapping="Wrap" Classes="muted" FontSize="11"/>
         <Border Height="1" Background="#393B45"/>
         <TextBlock Text="UTSL 核心版本" FontWeight="SemiBold"/>
         <ComboBox x:Name="EngineVersion" SelectionChanged="EngineVersionChanged" PlaceholderText="使用原服核心"/>
         <TextBlock x:Name="EngineDescription" Text="默认使用目标服原有核心" TextWrapping="Wrap" Classes="muted" FontSize="10"/>
         <Button x:Name="ImportCurrentEngineButton" Click="ImportCurrentEngineClick" Content="从当前停止服收录核心" HorizontalAlignment="Stretch"/>
         <Border Height="1" Background="#393B45"/>
         <TextBlock x:Name="RuntimeSelectionCount" Text="尚未载入插件选择" TextWrapping="Wrap" FontSize="11"/>
         <Button x:Name="ImportCurrentPluginsButton" Click="ImportCurrentPluginsClick" Content="导入此服现有插件并初始化选择" HorizontalAlignment="Stretch"/>
         <TextBlock Text="初次导入保留沙箱关闭状态，核对选择后再启用并保存。" TextWrapping="Wrap" Classes="muted" FontSize="10"/>
         <Border Height="1" Background="#393B45"/>
         <Button x:Name="SaveRuntimeButton" Click="SaveRuntimeClick" Content="保存此服运行配置" Classes="primary" HorizontalAlignment="Stretch"/>
         <Button x:Name="PreviewRuntimeButton" Click="PreviewRuntimeClick" Content="生成并查看已保存的沙箱" HorizontalAlignment="Stretch"/>
         <Button x:Name="CompactRuntimeButton" Click="CompactRuntimeClick" Content="整理为命名沙箱 · 保留一个上一版" HorizontalAlignment="Stretch" ToolTip.Tip="仅停止服可操作；核验旧沙箱后清理过期代次，未知内容保留并阻断"/>
         <TextBox x:Name="RuntimePreviewPath" PlaceholderText="沙箱预览路径" IsReadOnly="True" IsVisible="False" TextWrapping="Wrap" FontSize="10"/>
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Grid>
     <Expander x:Name="LegacyLibraryExpander" Grid.Row="3" Header="兼容模式 · 复制 DLL 到原服插件目录" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="LegacyLibraryExpanding">
      <Border Background="#202127" BorderBrush="#3A3B44" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
       <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" MaxHeight="245">
        <TextBlock Text="旧复制模式使用独立旧库，备份后写入上方目标服原插件目录；与独立沙箱选择分开管理。" TextWrapping="Wrap" FontSize="11" Foreground="#D6B37E"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock x:Name="PluginCount" Text="尚未载入旧库" Classes="muted" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Click="OpenLibraryClick" Content="打开旧库"/><Button x:Name="AddLegacyPluginsButton" Click="AddPluginsClick" Content="导入旧库 DLL"/></StackPanel></Grid>
        <ListBox x:Name="PluginList" Grid.Row="2" MinHeight="55" MaxHeight="110" SelectionMode="Multiple" Background="#1D1E23"/>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock x:Name="LegacyPluginStatus" Text="请选择旧库插件及上方目标服" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" FontSize="10"/><Button x:Name="ApplyLegacyPluginsButton" Grid.Column="1" Click="ApplyPluginsClick" Content="备份并复制所选到原服"/></Grid>
       </Grid>
      </Border>
     </Expander>
    </Grid>
    <ContentControl x:Name="MapsPage" IsVisible="False"/>
   </Grid>
   <Border Grid.Row="3" Background="#222329" BorderBrush="#36373F" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto" Margin="15,0"><TextBlock x:Name="StatusText" Text="本地工作区" Classes="muted" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="VersionText" Grid.Column="1" Text="流光工作室  ·  Pigeon-X" Foreground="#8B90A2" FontSize="10" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Border>
</Window>
