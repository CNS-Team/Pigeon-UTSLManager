+    internal bool SendForManager(string? name, string? command) {
+        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(command) || command.Length > 8192 || command.IndexOfAny(['\r', '\n', '\0']) >= 0) return false;
+        lock (gate) {
+            var entry = entries.Find(e => !e.Closed && e.Name == name && e.Server.IsRunning);
+            if (entry is null || entry.Pending.Count >= 64) return false;
+            entry.Pending.Enqueue(command);
+            entry.Signal.Release();
+            return true;
+        }
+    }
