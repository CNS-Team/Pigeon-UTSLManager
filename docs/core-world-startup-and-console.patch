diff --git a/src/UnifierTSL/Surface/Hosting/Unified/ManagerConsoleBridge.cs b/src/UnifierTSL/Surface/Hosting/Unified/ManagerConsoleBridge.cs
new file mode 100644
--- /dev/null
+++ b/src/UnifierTSL/Surface/Hosting/Unified/ManagerConsoleBridge.cs
@@ -0,0 +1,44 @@
+using System.IO.Pipes;
+using System.Text;
+using System.Text.Json;
+
+namespace UnifierTSL.Surface.Hosting.Unified;
+
+// Opt-in, local current-user IPC. No network listener, no command broadcast.
+internal static class ManagerConsoleBridge {
+    internal static readonly bool Enabled = !string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("UTSL_MANAGER_PIPE"));
+    private static int started;
+    internal static void EnsureStarted() {
+        if (!Enabled || Interlocked.Exchange(ref started, 1) != 0) return;
+        _ = Task.Run(Serve);
+    }
+    private sealed record Input(string Action, string? World = null, string? Value = null, long Cursor = 0);
+    private static readonly JsonSerializerOptions options = new() { PropertyNameCaseInsensitive = true };
+    private static async Task Serve() {
+        string name = Environment.GetEnvironmentVariable("UTSL_MANAGER_PIPE")!;
+        while (true) {
+            try {
+                using var pipe = new NamedPipeServerStream(name, PipeDirection.InOut, 1, PipeTransmissionMode.Byte, PipeOptions.Asynchronous | PipeOptions.CurrentUserOnly);
+                await pipe.WaitForConnectionAsync();
+                using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(10));
+                using var reader = new StreamReader(pipe, Encoding.UTF8, false, leaveOpen: true);
+                using var writer = new StreamWriter(pipe, new UTF8Encoding(false), leaveOpen: true) { AutoFlush = true };
+                string line = await reader.ReadLineAsync(deadline.Token) ?? "";
+                object reply;
+                if (line.Length > 16_384) reply = new { Ok = false, Message = "Request too large" };
+                else {
+                    var input = JsonSerializer.Deserialize<Input>(line, options) ?? throw new IOException("Empty request");
+                    reply = input.Action switch {
+                        "read" => UnifiedConsoleHub.Instance.ReadForManager(input.World, input.Cursor),
+                        "send" => new { Ok = UnifiedConsoleHub.Instance.SendForManager(input.World, input.Value), Message = "Exact-world input only" },
+                        _ => new { Ok = false, Message = "Unknown action" }
+                    };
+                }
+                await writer.WriteLineAsync(JsonSerializer.Serialize(reply).AsMemory(), deadline.Token);
+            } catch (Exception) {
+                // An absent/disconnected manager must never terminate a game world.
+                await Task.Delay(100);
+            }
+        }
+    }
+}
